{
  "rewrites": [
    {
      "source": "/webr_repo_v5/:path(.*\\.rds)",
      "destination": "/api/webr-not-found"
    },
    {
      "source": "/webr_repo_v5/:path(.*\\.gz)",
      "destination": "/api/webr-not-found"
    }
  ],
  "crons": [
    {
      "path": "/api/keep-alive",
      "schedule": "0 12 * * *"
    }
  ]
}
